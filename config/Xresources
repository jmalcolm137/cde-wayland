! CDE-on-Wayland X resources.
!
! The shim publishes the root RESOURCE_MANAGER property from the user's
! ~/.Xresources / ~/.Xdefaults, or from $XENVIRONMENT.  cde-session.sh points
! XENVIRONMENT here when the user has no resources of their own, so CDE Motif
! programs get a CDE-ish default look without a running X server.
!
! This is a starting point; the real palette will come from CDE's own
! resources as dtstyle/backdrops are wired up.

*customization:		-color

! CDE's default "grey" workspace and black text.
*Background:		#aeb2c3
*Foreground:		#000000
*highlightColor:	#aeb2c3
*armColor:		#aeb2c3

! A readable proportional and fixed font; the shim matches these XLFDs through
! fontconfig and never fails to load a font.
*fontList: -*-helvetica-medium-r-normal--14-*-*-*-*-*-iso8859-1
*XmText*fontList: -*-courier-medium-r-normal--14-*-*-*-*-*-iso8859-1

! DtTerm's terminal font must be a *fontset*, not a plain font.  In a
! multibyte locale DtTerm stores wide characters; if Motif hands it a plain
! font it takes the single-font XDrawImageString path and only len/4 glyphs
! appear.  Motif's trailing-colon syntax (as used by CDE's own
! sys.resources: `*userFont: ...:^*XmText*FontList`) selects
! XmFONT_IS_FONTSET, so the widget uses Xwc/Xmb instead.
*userFont: -misc-fixed-medium-r-normal--14-*-*-*-*-*-iso8859-1:
*userBoldFont: -misc-fixed-bold-r-normal--14-*-*-*-*-*-iso8859-1:

! Motif widget colours close to the CDE defaults.
*XmList.selectColor:		#0f3977
*XmList.selectBackground:	#0f3977
*XmPushButton.background:	#aeb2c3
*XmPushButton.foreground:	#000000
*XmToggleButton.selectColor:	#0f3977

! The Style Manager - Font dialog matches the current *systemFont against its
! Dtstyle*SystemFont1..7 list (14-pt Helvetica by default).  Set the system
! font to that same entry so the dialog selects the current size instead of
! reporting that the font in use cannot be found (which also leaves the
! preview empty).
*systemFont: -adobe-helvetica-medium-r-normal--14-*-iso8859-1

! CDE window decorations that the shim maps to CoW/River window hints.
*XmDialogShell.title:		CDE

! The CDE session manager (dtsession) must not start a window manager of its
! own: CoW is the window manager here, and the Front Panel (dtwm) is started
! separately by cde-session.sh.  Without this dtsession forks a second dtwm,
! which fights the contained panel over the Workspace Manager protocol.
Dtsession*wmStartupCommand:	/bin/true
