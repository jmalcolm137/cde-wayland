/*
 * cde-host.def.in — CDE-on-Wayland imake overlay.
 *
 * This file is generated by scripts/build-cde.sh into the *build tree's*
 * config/cf/host.def.  host.def is imake's sanctioned local-configuration file
 * (empty in the pristine CDE tree), so filling it in does not modify CDE
 * source.  It is included from config/cf/site.def inside BeforeVendorCF, so a
 * few settings that a vendor file defines unconditionally are overridden on
 * the make command line by the build script instead.
 *
 * Substitutions: @CDE_PREFIX@ @CDE_ROOT@ @CPP@
 */

/* Where CDE installs.  Relocatable, no /usr/dt, no root. */
#define CdeInstallationTop	@CDE_ROOT@
#define CdeConfigurationTop	@CDE_ROOT@/config
#define CdeUserTop		.dt

/* Find X11 (our shim) and Motif (built against the shim) in our prefix. */
#define X11ProjectRoot		@CDE_PREFIX@
#define MotifProjectRoot	@CDE_PREFIX@

/* Use the installed shim + Motif rather than source trees. */
#define UseInstalledX11		YES
#define UseInstalledMotif	YES

/* v1: the shim does not implement the Xinerama extension; DtXinerama and the
 * parts of DtSvc that use it fall back to a single screen. */
#define CDE_USEXINERAMA		NO

/* Skip non-C locales and the documentation on the first pass: they need
 * tooling (msgfmt, dtdocbook) that is not required to bring the apps up. */
#define DtLocalesToBuild
#define DtDocLocalesToBuild

/* Point the compiler and linker at the shim's headers and libraries. */
#define StandardIncludes	-I@CDE_PREFIX@/include
#define CplusplusExtraIncludes	-I@CDE_PREFIX@/include
#define LdPreLibs		-L@CDE_PREFIX@/lib -Wl,-rpath,@CDE_PREFIX@/lib

/* Modern systems do not have /lib/cpp.  The bootstrap imake binary is built
 * with -DCPP_PROGRAM="..." by the build script; this is for anything else. */
#define CppCmd			@CPP@
