--- a/programs/dtwm/WmProperty.c
+++ b/programs/dtwm/WmProperty.c
@@ -37,6 +37,8 @@
 #include "WmGlobal.h"
 #include "WmICCC.h"
 #include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
 #include <Dt/WsmP.h>
 #include <X11/Xatom.h>
 #include <Xm/AtomMgr.h>
@@ -1232,6 +1234,57 @@
 
     XtFree ((char *) pWsList);
 
+    /* cde-wayland: record the workspace set for the shim's synthetic WM window
+     * (see docs/WORKSPACE-MANAGER.md).  Every client reads the workspace list
+     * from its own private X server, so a workspace added or deleted from the
+     * Front Panel only reaches the other clients if the shared state file the
+     * shim publishes is updated; the shim re-reads it on each DtWsm query. */
+    {
+	const char *state = getenv("CDE_WSM_STATE");
+	char path[1024];
+	char names[1024];
+	size_t off = 0;
+	int cur = 0;
+	int i;
+	FILE *f;
+
+	if (!state || !*state) {
+	    const char *rt = getenv("XDG_RUNTIME_DIR");
+	    snprintf(path, sizeof path, "%s/cde-wayland/workspace",
+		     (rt && *rt) ? rt : "/tmp");
+	    state = path;
+	}
+
+	/* Keep the current workspace recorded by cde-wsm-desk. */
+	if ((f = fopen(state, "r")) != NULL) {
+	    char line[256];
+	    while (fgets(line, sizeof line, f))
+		if (strncmp(line, "current=", 8) == 0)
+		    cur = atoi(line + 8);
+	    fclose(f);
+	}
+	if (cur < 0 || cur >= pSD->numWorkspaces)
+	    cur = 0;
+
+	names[0] = 0;
+	for (i = 0; i < pSD->numWorkspaces; i++) {
+	    const char *nm = pSD->pWS[i].name ? pSD->pWS[i].name : "ws";
+	    size_t l = strlen(nm);
+	    if (off + l + 2 >= sizeof names)
+		break;
+	    if (i)
+		names[off++] = ',';
+	    memcpy(names + off, nm, l);
+	    off += l;
+	    names[off] = 0;
+	}
+
+	if ((f = fopen(state, "w")) != NULL) {
+	    fprintf(f, "names=%s\ncurrent=%d\n", names, cur);
+	    fclose(f);
+	}
+    }
+
 } /* END OF FUNCTION SetWorkspaceListProperty */
 
 
