diff --git a/src/stack.c b/src/stack.c
index c019b6e..ba774bd 100644
--- a/src/stack.c
+++ b/src/stack.c
@@ -45,6 +45,26 @@
 
 static bool stack_dirty;
 
+/*
+ * Keep a window's transients (WM_TRANSIENT_FOR, `view->parent`) directly above
+ * it: when a window is raised, its dialogs go with it.  MWM/CDE keep a dialog
+ * on top of the window it belongs to, so clicking or focusing the application
+ * window must not bury its dialog.  Recurse for nested dialogs.
+ */
+static void
+raise_transient_children(struct cow_view *parent)
+{
+	struct cow_view *child;
+	wl_list_for_each(child, &cow_wm.views, wm_link)
+	{
+		if (child->closed || child == parent ||
+		    child->parent != parent)
+			continue;
+		child->raise_seq = ++cow_wm.raise_seq_counter;
+		raise_transient_children(child);
+	}
+}
+
 void
