# Modification: honour River PREFERS_CSD decoration hint for standalone windows
# during the manage sequence via cow_view_has_frame()/cow_view_reconcile_frame()
# (containers retain shared-frame ownership; ONLY_SUPPORTS_CSD stays under CoW's
# default SSD policy).  This covers xlib-wayland's borderless (_MOTIF_WM_HINTS
# decorations=0) windows rather than full per-element MWM hint reconstruction;
# 2026-10-04, revised 2026-11-22.
#
diff --git a/include/cow/view.h b/include/cow/view.h
index a50ae60..518dcaf 100644
--- a/include/cow/view.h
+++ b/include/cow/view.h
@@ -368,6 +368,7 @@ struct cow_view {
 
 	/* Decoration hint from the window */
 	uint32_t decoration_hint;
+	bool     decoration_hint_pending;
 	uint32_t presentation_hint;
 
 	/* State tracking */
@@ -504,6 +505,8 @@ void cow_view_flush_titles(void);
 void cow_view_clear_orphan(struct cow_view *);
 
 /* Configure/render a view during WM cycles. */
+bool cow_view_prefers_csd(const struct cow_view *);
+void cow_view_apply_decoration_hint(struct cow_view *);
 void cow_view_configure(struct cow_view *);
 void cow_view_apply_render(struct cow_view *);
 
diff --git a/src/view.c b/src/view.c
index eb455d3..899be78 100644
--- a/src/view.c
+++ b/src/view.c
@@ -464,7 +464,16 @@ window_handle_decoration_hint(void *data, __unused struct river_window_v1 *rw,
     uint32_t hint)
 {
 	struct cow_view *view = data;
+	if (view->decoration_hint == hint)
+		return;
 	view->decoration_hint = hint;
+	/* River requires use_csd/use_ssd during a manage sequence, never
+	 * directly from this event handler.  Defer negotiation to
+	 * manage_configure_views(). */
+	if (view->configured) {
+		view->decoration_hint_pending = true;
+		cow_update_request(COW_UPDATE_MANAGE);
+	}
 }
 
 static void
@@ -736,18 +745,47 @@ cow_view_clear_orphan(struct cow_view *view)
 	}
 }
 
+bool
+cow_view_prefers_csd(const struct cow_view *view)
+{
+	/* Containers own the shared frame for their members: a client's CSD
+	 * preference never suppresses the container frame. */
+	if (cow_view_container(view) != NULL ||
+	    cow_container_window_owner(view) != NULL)
+		return false;
+	/* Honour an explicit zxdg-decoration CLIENT_SIDE preference
+	 * (PREFERS_CSD) on standalone windows while leaving ONLY_SUPPORTS_CSD
+	 * under CoW's default SSD policy. */
+	return view->decoration_hint ==
+	    RIVER_WINDOW_V1_DECORATION_HINT_PREFERS_CSD;
+}
+
+void
+cow_view_apply_decoration_hint(struct cow_view *view)
+{
+	view->decoration_hint_pending = false;
+	if (!view->configured || view->closed)
+		return;
+	if (cow_view_prefers_csd(view))
+		river_window_v1_use_csd(view->river_window);
+	else
+		river_window_v1_use_ssd(view->river_window);
+	cow_view_reconcile_frame(view);
+	view->decoration_hint_pending = false;
+}
+
 void
 cow_view_configure(struct cow_view *view)
 {
 	if (view->configured)
 		return;
 
-	/* Always use SSD -- the WM controls decorations, not the client.
-	 * We tell the window to use SSD regardless of its preference.
-	 * Windows that "only support CSD" will just draw their own
-	 * decorations inside the content area, and we draw ours outside. */
-	river_window_v1_use_ssd(view->river_window);
+	if (cow_view_prefers_csd(view))
+		river_window_v1_use_csd(view->river_window);
+	else
+		river_window_v1_use_ssd(view->river_window);
 	cow_view_reconcile_frame(view);
+	view->decoration_hint_pending = false;
 
 	/* Set capabilities */
 	river_window_v1_set_capabilities(view->river_window,
@@ -1665,23 +1703,26 @@ cow_view_restore_expanded_geometry(struct cow_view *view)
 bool
 cow_view_has_frame(const struct cow_view *view)
 {
- /* CoW's client policy remains SSD. Fullscreen and container ownership
-  * determine whether this view currently contributes a frame.
-  */
- return !view->fullscreen && cow_container_owns_frame(view);
+	/* Fullscreen, standalone PREFERS_CSD, and container ownership determine
+	 * whether this view currently contributes a frame.
+	 */
+	return !view->fullscreen && !cow_view_prefers_csd(view) &&
+	    cow_container_owns_frame(view);
 }
 
 void
 cow_view_reconcile_frame(struct cow_view *view)
 {
- bool owns_frame = cow_view_has_frame(view);
- if (view->use_ssd == owns_frame) return;
- view->use_ssd = owns_frame;
- view->dec.dirty = true;
- /* Surface retirement stays deferred until render, so queued pointer
-  * interactions cannot reference a prematurely destroyed decoration.
-  */
- cow_update_request(COW_UPDATE_MANAGE | COW_UPDATE_STATUS);
+	bool owns_frame = cow_view_has_frame(view);
+	if (view->use_ssd == owns_frame)
+		return;
+	view->use_ssd = owns_frame;
+	view->decoration_hint_pending = true;
+	view->dec.dirty = true;
+	/* Surface retirement stays deferred until render, so queued pointer
+	 * interactions cannot reference a prematurely destroyed decoration.
+	 */
+	cow_update_request(COW_UPDATE_MANAGE | COW_UPDATE_STATUS);
 }
 
 struct cow_box
diff --git a/src/wm.c b/src/wm.c
index 6546fef..c77dee5 100644
--- a/src/wm.c
+++ b/src/wm.c
@@ -570,8 +570,12 @@ manage_configure_views(void)
 	struct cow_view *view;
 	wl_list_for_each(view, &cow_wm.views, wm_link)
 	{
-		if (!view->configured && !view->closed)
+		if (view->closed)
+			continue;
+		if (!view->configured)
 			cow_view_configure(view);
+		else if (view->decoration_hint_pending)
+			cow_view_apply_decoration_hint(view);
 	}
 }
 
