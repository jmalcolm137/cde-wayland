-static char	*spool_dir = _DtCMS_DEFAULT_DIR;
+/* cde-wayland: allow rpc.cmsd to run as an ordinary user with a private spool
+ * directory (CDE_CMSD_DIR), instead of the root-owned /var/spool/calendar. */
+static char	*spool_dir = NULL;
+
+static char *
+cmsd_spool_dir(void)
+{
+	char *d;
+
+	if (spool_dir == NULL) {
+		d = getenv("CDE_CMSD_DIR");
+		spool_dir = (d && *d) ? d : _DtCMS_DEFAULT_DIR;
+	}
+	return spool_dir;
+}
 
