+     */
+    startup.origStartState = cdeReadStartState();
+    startup.origConfirmMode = cdeReadConfirmMode();
+    style.smState.smStartState = startup.origStartState;
+    style.smState.smConfirmMode = startup.origConfirmMode;
 }
 
 
