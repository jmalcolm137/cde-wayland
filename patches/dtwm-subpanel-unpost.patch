# Modification: unmap a sub-panel instead of CallWmFunction(F_Kill); 2026-10-04.
#
--- a/programs/dtwm/Callback.c
+++ b/programs/dtwm/Callback.c
@@ -233,9 +233,12 @@
    }
    else
    {
-      /*  Execute the window manager function to unpost the subpanel  */
-
-      CallWmFunction (F_Kill, NULL, subpanel_data->shell, NULL);
+      /*  Unpost the subpanel.  In real CDE the window manager does this
+       *  (CallWmFunction(F_Kill, ...)); CoW is the window manager here and does
+       *  not know about dtwm's sub-panels, so unmanage the shell ourselves.
+       *  That unmaps it and fires SubpanelUnmapCB, which resets the arrow
+       *  image, leaving the shell intact for the next posting. */
+      XtUnmanageChild (subpanel_data->shell);
    }
 }
 
