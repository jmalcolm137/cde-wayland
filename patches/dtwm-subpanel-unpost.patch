--- a/programs/dtwm/Callback.c
+++ b/programs/dtwm/Callback.c
@@ -236,6 +236,11 @@
       /*  Execute the window manager function to unpost the subpanel  */
 
       CallWmFunction (F_Kill, NULL, subpanel_data->shell, NULL);
+
+      /* cde-wayland: CoW is the window manager, so F_Kill does not unmap the
+       * sub-panel; unmanage the shell ourselves so it actually disappears.
+       * Unmapping fires SubpanelUnmapCB, which resets the arrow image. */
+      XtUnmanageChild (subpanel_data->shell);
    }
 }
 
