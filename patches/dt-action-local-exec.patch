+static int
+_DtLocalActionFind(const char *name, int want_argc, const char *want_type,
+                   int strict, int argc, char **argv,
+                   char *out, size_t outsz, int depth)
+{
+    char paths[8192];
+    char bestmap[512];
+    bestmap[0] = '\0';
+    const char *dts = getenv("DTDATABASESEARCHPATH");
+    if (dts && *dts) {
+        strncpy(paths, dts, sizeof(paths) - 1); paths[sizeof(paths) - 1] = '\0';
+    } else {
+        const char *root = getenv("CDE_ROOT");
+        if (!root || !*root) root = "/usr/dt";
+        snprintf(paths, sizeof paths,
+                 "%s/appconfig/types:%s/appconfig/types/C", root, root);
+    }
+    char *save = NULL;
+    if (getenv("CDE_ACTION_DEBUG") && depth == 0)
+        fprintf(stderr, "MWACT paths=[%s]\n", paths);
+    /* CDE separates database directories with a comma; accept a colon too
+     * so the same code works with a hand-set DTDATABASESEARCHPATH. */
+    for (char *dir = strtok_r(paths, ",:", &save); dir;
+         dir = strtok_r(NULL, ",:", &save)) {
+        char d[4096];
+        char *pct = strstr(dir, "%L");
+        if (pct)
+            snprintf(d, sizeof d, "%.*sC%s", (int)(pct - dir), dir, pct + 2);
+        else
+            snprintf(d, sizeof d, "%s", dir);
+        DIR *dp = opendir(d);
+        if (!dp) continue;
+        struct dirent *de;
+        while ((de = readdir(dp)) != NULL) {
+            size_t nl = strlen(de->d_name);
+            char fp[4096], line[4096], mapact[512], type[64],
+                 execstr[2048], argtype[64];
+            int argcnt, exec_cont = 0;
+            FILE *f;
+            int in = 0;
+            if (nl < 3 || strcmp(de->d_name + nl - 3, ".dt") != 0) continue;
+            snprintf(fp, sizeof fp, "%s/%s", d, de->d_name);
+            f = fopen(fp, "r");
+            if (!f) continue;
+            while (fgets(line, sizeof line, f)) {
+                char *s = line;
+                while (*s == ' ' || *s == '\t') s++;
+                if (!in) {
+                    if (strncmp(s, "ACTION", 6) == 0 &&
+                        (s[6] == ' ' || s[6] == '\t')) {
+                        char *a = s + 7, *e;
+                        while (*a == ' ' || *a == '\t') a++;
+                        e = a;
+                        while (*e && *e != ' ' && *e != '\t' && *e != '\n' &&
+                               *e != '\r' && *e != '{') e++;
+                        if ((size_t)(e - a) == strlen(name) &&
+                            strncmp(a, name, (size_t)(e - a)) == 0) {
+                            in = 1; exec_cont = 0;
+                            type[0] = argtype[0] = mapact[0] = '\0';
+                            execstr[0] = '\0'; argcnt = -1;
+                        }
+                    }
+                    continue;
+                }
+                /* A command line may continue onto the next line(s). */
+                if (exec_cont && *s != '}' && *s != '"') exec_cont = 0;
+                if (exec_cont && *s == '"') {
+                    size_t l = strlen(execstr);
+                    if (l + 1 < sizeof execstr) {
+                        snprintf(execstr + l, sizeof execstr - l, " %s", s);
+                        execstr[strcspn(execstr, "\r\n")] = '\0';
+                    }
+                    continue;
+                }
+                if (*s == '}') {
+                    /* End of the block: judge it now.  A database may define a
+                     * name once per ARG_COUNT and per ARG_TYPE (Dticon with and
+                     * without a file; Open once per datatype).  Judging only
+                     * once, after the file's last block, both skipped the
+                     * earlier blocks and carried a stale ARG_COUNT across them. */
+                    in = 0; exec_cont = 0;
+                    if (getenv("CDE_ACTION_DEBUG"))
+                        fprintf(stderr, "MWACT blk %s: type=%s argc=%d "
+                                "argtype=[%s] exec=[%s]\n",
+                                name, type, argcnt, argtype, execstr);
+                    if (strcmp(type, "COMMAND") == 0 && execstr[0]) {
+                        int type_ok = !(strict && want_type && argtype[0]) ||
+                                      (strcmp(argtype, want_type) == 0);
+                        if (type_ok && _dtl_argc_ok(argcnt, want_argc)) {
+                            fclose(f); closedir(dp);
+                            _dtl_expand(execstr, argc, argv, out, outsz);
+                            return 1;
+                        }
+                    } else if (strcmp(type, "MAP") == 0 && mapact[0] &&
+                               !bestmap[0]) {
+                        /* Remember the first mapped action that fits; do not
+                         * recurse yet, or a map whose target is a ToolTalk
+                         * message (e.g. the InfoManager's Open) would abort the
+                         * whole search before the real Open for this datatype
+                         * is found in a later file. */
+                        int type_ok = !(strict && want_type && argtype[0]) ||
+                                      (strcmp(argtype, want_type) == 0);
+                        if (type_ok && _dtl_argc_ok(argcnt, want_argc))
+                            snprintf(bestmap, sizeof bestmap, "%s", mapact);
+                    }
+                    continue;
+                }
+                if (strncmp(s, "TYPE", 4) == 0) {
+                    char *v = s + 4; while (*v == ' ' || *v == '\t') v++;
+                    sscanf(v, "%63s", type);
+                } else if (strncmp(s, "MAP_ACTION", 10) == 0) {
+                    char *v = s + 10; while (*v == ' ' || *v == '\t') v++;
+                    sscanf(v, "%511s", mapact);
+                } else if (strncmp(s, "ARG_COUNT", 9) == 0) {
+                    char *v = s + 9; while (*v == ' ' || *v == '\t') v++;
+                    argcnt = atoi(v);
+                } else if (strncmp(s, "ARG_TYPE", 8) == 0) {
+                    char *v = s + 8; while (*v == ' ' || *v == '\t') v++;
+                    sscanf(v, "%63[^,\r\n \t]", argtype);
+                } else if (strncmp(s, "EXEC_STRING", 11) == 0) {
+                    char *v = s + 11; size_t l;
+                    while (*v == ' ' || *v == '\t') v++;
+                    l = strcspn(v, "\r\n");
+                    if (l >= sizeof execstr) l = sizeof execstr - 1;
+                    memcpy(execstr, v, l); execstr[l] = '\0';
+                    exec_cont = 1;
+                }
+            }
+            fclose(f);
+        }
+        closedir(dp);
+    }
+    if (bestmap[0] && depth < 8)
+        return _DtLocalActionFind(bestmap, want_argc, want_type, strict,
+                                  argc, argv, out, outsz, depth + 1);
+    return 0;
+}
+
+static int
+_DtLocalActionRun(const char *name, int argc, DtActionArg *aap)
+{
+    char out[4096], tb[128];
+    char *argv[16];
+    int n = 0, i;
+    const char *want_type = NULL;
+    /* The File Manager buttons run dtfile with CDE_DTFILE_SHOW naming the
+     * view to open (the shim's private X root defeats dtfile's own
+     * single-server lock). */
+    static const struct { const char *action; const char *cmd; } builtin[] = {
+        { "DtfileHome",     "exec \"$CDE_ROOT\"/bin/dtfile -dir \"$HOME\"" },
+        { "Dtfile",         "exec \"$CDE_ROOT\"/bin/dtfile -dir \"$PWD\"" },
+        { "Dttrash",        "mkdir -p \"$HOME/.dt/Trash\"; exec \"$CDE_ROOT\"/bin/dtfile -dir \"$HOME/.dt/Trash\"" },
+        { "Trash",          "mkdir -p \"$HOME/.dt/Trash\"; exec \"$CDE_ROOT\"/bin/dtfile -dir \"$HOME/.dt/Trash\"" },
+        { "Dtappmgr",       "exec \"$CDE_ROOT\"/bin/dtfile -title \"Application Manager\" -dir \"${TARGET_APPMAN_DIR:-$CDE_ROOT/appconfig/appmanager/gathered}\"" },
+        { "TextEditor",     "exec \"$CDE_ROOT\"/bin/dtpad" },
+        { "Dtpad",          "exec \"$CDE_ROOT\"/bin/dtpad" },
+        { "Dtmail",         "exec \"$CDE_ROOT\"/bin/dtmail" },
+        { "OpenDtIntro",    "exec \"$CDE_ROOT\"/bin/dthello" },
+        { "Dtstyle",        "exec \"$CDE_ROOT\"/bin/dtstyle" },
+        { "Dtcm",           "exec \"$CDE_ROOT\"/bin/dtcm" },
+        { "Dtterm",         "exec \"$CDE_ROOT\"/bin/dtterm" },
+        { "Terminal",       "exec \"$CDE_ROOT\"/bin/dtterm" },
+        /* The Information Manager (dtinfo) is not built; do nothing rather than
+         * post a ToolTalk error dialog. */
+        { "DtLoadInfoLib",  "true" },
+        { NULL, NULL }
+    };
+    if (!name || !*name) return 0;
+
+    /* Collect the arguments the caller supplied (file and string arguments
+     * carry their value in u.file.name; buffer arguments in u.buffer.name). */
+    for (i = 0; aap && i < argc && n < 16; i++) {
+        if (aap[i].argClass == DtACTION_FILE && aap[i].u.file.name)
+            argv[n++] = aap[i].u.file.name;
+        else if (aap[i].argClass == DtACTION_BUFFER && aap[i].u.buffer.name)
+            argv[n++] = aap[i].u.buffer.name;
+        else if (aap[i].argClass == DtACTION_STRING && aap[i].u.file.name)
+            argv[n++] = aap[i].u.file.name;
+    }
+    /* A file argument's datatype disambiguates actions that are defined once
+     * per type (Open, Print, ...). */
+    if (n > 0 && argv[0] && strchr(argv[0], '/')) {
+        char *t = DtDtsFileToDataType(argv[0]);
+        if (t && *t) {
+            strncpy(tb, t, sizeof tb - 1); tb[sizeof tb - 1] = '\0';
+            want_type = tb;
+        }
+    }
+
+    out[0] = '\0';
+    if (getenv("CDE_ACTION_DEBUG"))
+        fprintf(stderr, "MWACT run name=%s argc=%d argv0=%s want_type=%s\n",
+                name, n, n > 0 ? argv[0] : "-",
+                want_type ? want_type : "(null)");
+    /* With a datatype only the type-matched pass may be trusted: the loose
+     * pass would pick an arbitrary block (the generic "cannot open" action). */
+    {
+        int found = _DtLocalActionFind(name, n, want_type, 1, n, argv, out,
+                                       sizeof out, 0);
+        if (!found && !want_type)
+            found = _DtLocalActionFind(name, n, NULL, 0, n, argv, out,
+                                       sizeof out, 0);
+        if (found && getenv("CDE_ACTION_DEBUG"))
+            fprintf(stderr, "MWACT found -> %s\n", out);
+        if (found && out[0]) {
+            _DtLocalActionExec(out);
+            return 1;
+        }
+    }
+    if (getenv("CDE_ACTION_DEBUG"))
+        fprintf(stderr, "MWACT not resolved\n");
+
+    /* Built-ins for the panel buttons and the File Manager's location
+     * buttons.  With arguments these are appended, so e.g. TextEditor <file>
+     * opens the file rather than an empty editor. */
+    for (i = 0; builtin[i].action; i++) {
+        if (strcmp(name, builtin[i].action) == 0) {
+            const char *root = getenv("CDE_ROOT");
+            char expanded[4096];
+            if (root && strncmp(builtin[i].cmd, "$CDE_ROOT", 9) == 0)
+                snprintf(expanded, sizeof expanded, "%s%s", root,
+                         builtin[i].cmd + 9);
+            else
+                snprintf(expanded, sizeof expanded, "%s", builtin[i].cmd);
+            if (n > 0)
+                _dtl_append_args_on(expanded, sizeof expanded, n, argv);
+            _DtLocalActionExec(expanded);
+            return 1;
+        }
+    }
+    /* Text has no command action: its Open/Print map ends in a ToolTalk media
+     * message (DtTTMediaOpen) that asks a running editor to display the file.
+     * Start the editor on the file instead. */
+    if (n > 0 && want_type &&
+        (strcmp(want_type, "TEXTFILE") == 0 ||
+         strcmp(want_type, "ENRICHED_TEXT") == 0 ||
+         strcmp(want_type, "RICHTEXT") == 0)) {
+        const char *root = getenv("CDE_ROOT");
+        char expanded[4096];
+        snprintf(expanded, sizeof expanded, "exec \"%s\"/bin/dtpad",
+                 root ? root : "/usr/dt");
+        _dtl_append_args_on(expanded, sizeof expanded, n, argv);
+        _DtLocalActionExec(expanded);
+        return 1;
+    }
+    return 0;
+}
