+/* ------------------------------------------------------------------------
+ * CDE-on-Wayland: execute an action locally, without ToolTalk.
+ *
+ * ToolTalk is not usable in the Wayland session, so when DtActionInvoke would
+ * otherwise fail we resolve the action name against the .dt databases and run
+ * its command directly.  This makes the Front Panel's launch buttons work.
+ * This is a cde-wayland build overlay (patches/dt-action-local-exec.patch); it
+ * is not part of upstream CDE.
+ */
+static void
+_DtLocalActionExec(const char *cmd)
+{
+    char buf[4096];
+    const char *root = getenv("CDE_ROOT");
+    size_t o = 0;
+    if (!root || !*root) root = "/usr/dt";
+    while (*cmd && o < sizeof(buf) - 1) {
+        if (strncmp(cmd, "/usr/dt", 7) == 0) {
+            size_t rl = strlen(root);
+            if (o + rl > sizeof(buf) - 1) break;
+            memcpy(buf + o, root, rl); o += rl; cmd += 7;
+        } else {
+            buf[o++] = *cmd++;
+        }
+    }
+    buf[o] = '\0';
+    if (fork() == 0) {
+        setsid();
+        /* The action itself was launched locally, but the program it runs is a
+         * normal CDE client: let it use ToolTalk (the session exports
+         * TT_SESSION) so programs like the File Manager/Mailer behave.  Only
+         * the Front Panel (dtwm) runs ToolTalk-free. */
+        unsetenv("CDE_NO_TOOLTALK");
+        execl("/bin/sh", "sh", "-c", buf, (char *)NULL);
+        _exit(127);
+    }
+}
+
+/* Match a block against the requested argument count.  CDE ranks an explicit
+ * ARG_COUNT over an absent (wildcard) one, and a wildcard block accepts any
+ * number of arguments. */
+/* cde-wayland: the local action overlay can be disabled with
+ * CDE_LOCAL_ACTIONS=0, which leaves CDE's own execution path in charge. */
+static int _dtl_enabled(void)
+{
+    const char *e = getenv("CDE_LOCAL_ACTIONS");
+    return !(e && e[0] == '0' && e[1] == '\0');
+}
+
+static int
+_dtl_argc_ok(int argcnt, int want)
+{
+    if (argcnt == want) return 1;
+    if (want > 0 && argcnt < 0) return 1;
+    return 0;
+}
+
+/* Shell-quote one argument. */
+static void
+_dtl_quote(const char *in, char *out, size_t outsz)
+{
+    size_t o = 0;
+    if (o + 1 < outsz) out[o++] = '\'';
+    for (; in && *in && o + 8 < outsz; in++) {
+        if (*in == '\'') { memcpy(out + o, "'\\''", 4); o += 4; }
+        else out[o++] = *in;
+    }
+    if (o + 1 < outsz) out[o++] = '\'';
+    out[o] = '\0';
+}
+
+/* Expand the argument references in a CDE command line.  Handles both the
+ * %Arg_n% / %Args% keywords and the .dt form %(class)Arg_n, including an
+ * optional following "default" and the trailing % of the %(...)...% spelling. */
+static void
+_dtl_expand(const char *in, int argc, char **argv, char *out, size_t outsz)
+{
+    size_t o = 0;
+    const char *p = in;
+    while (*p && o + 1 < outsz) {
+        if (p[0] == '%' && p[1] == '(') {
+            const char *cl = strchr(p, ')');
+            if (cl && strncmp(cl + 1, "Arg_", 4) == 0) {
+                int n = atoi(cl + 5) - 1;
+                p = cl + 5;
+                /* Consume the rest of this token: an optional "default" and
+                 * the trailing % of the %(...)...% spelling. */
+                while (*p && *p != ' ' && *p != '\t') {
+                    if (*p == '%') { p++; break; }
+                    p++;
+                }
+                if (*p == '"') p++;   /* trailing quote of the .dt spelling */
+                if (o > 0 && out[o - 1] == '"') o--;   /* drop the opening quote */
+                if (n >= 0 && n < argc && argv[n]) {
+                    char q[4096];
+                    _dtl_quote(argv[n], q, sizeof q);
+                    const char *x = q; while (*x && o + 1 < outsz) out[o++] = *x++;
+                }
+                continue;
+            }
+        }
+        if (strncmp(p, "%Arg_", 5) == 0) {
+            int n = atoi(p + 5) - 1;
+            const char *e = strchr(p + 5, '%');
+            if (n >= 0 && n < argc && argv[n]) {
+                char q[4096];
+                _dtl_quote(argv[n], q, sizeof q);
+                const char *x = q; while (*x && o + 1 < outsz) out[o++] = *x++;
+            }
+            p = e ? e + 1 : p + 5;
+            continue;
+        }
+        if (strncmp(p, "%Args%", 6) == 0) {
+            int i;
+            for (i = 0; i < argc; i++) {
+                if (!argv[i]) continue;
+                if (i && o + 1 < outsz) out[o++] = ' ';
+                char q[4096];
+                _dtl_quote(argv[i], q, sizeof q);
+                const char *x = q; while (*x && o + 1 < outsz) out[o++] = *x++;
+            }
+            p += 6;
+            continue;
+        }
+        out[o++] = *p++;
+    }
+    out[o] = '\0';
+}
+
+/* Append shell-quoted arguments to an existing command string. */
+static void
+_dtl_append_args_on(char *buf, size_t sz, int argc, char **argv)
+{
+    size_t o = strlen(buf);
+    int i;
+    for (i = 0; i < argc && o + 1 < sz; i++) {
+        char q[4096];
+        int w;
+        _dtl_quote(argv[i], q, sizeof q);
+        w = snprintf(buf + o, sz - o, " %s", q);
+        if (w < 0 || (size_t)w >= sz - o) break;
+        o += (size_t)w;
+    }
+}
